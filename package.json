{
  "name": "an-types",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript type definitions for browser libraries distributed via CDN, in the spirit of DefinitelyTyped.",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "clean": "pnpm -r run clean",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r --filter \"./packages/*\" run lint",
    "check:consumer": "pnpm --filter consumer run test",
    "verify:source": "node tools/verify-source.mjs",
    "verify:source:offline": "node tools/verify-source.mjs --offline",
    "check:coverage": "node tools/check-coverage.mjs",
    "check:links": "node tools/check-doc-links.mjs",
    "audit": "node tools/verify-source.mjs && node tools/check-coverage.mjs && node tools/check-doc-links.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:consumer && pnpm run audit"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
